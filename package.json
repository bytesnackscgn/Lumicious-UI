{
  "name": "lumicious-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Solid, testable, high-scalable UI component framework",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/lumicious-ui.css",
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "require": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "pnpm build",
    "compile": "vue-tsc -b",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "kill:vite": "lsof -ti:5173 | xargs kill -9",
    "kill:storybook": "lsof -ti:6006 | xargs kill -9"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^13.0.6",
    "lucide-vue-next": "^0.563.0",
    "tailwind-merge": "^3.6.0",
    "vue": "3.5.35"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-onboarding": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/test": "^8.6.15",
    "@storybook/vue3-vite": "^10.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.17.0",
    "eslint-plugin-oxlint": "^1.41.0",
    "eslint-plugin-storybook": "^10.2.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.0",
    "storybook": "^10.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3",
    "vite": "^8.0.0-beta.9",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.3"
  }
}

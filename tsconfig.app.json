{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/*", "src/**/*.stories.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "./src",
    "paths": { "@/*": ["./src/*"] }
  }
}